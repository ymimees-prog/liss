# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token
# Твой Telegram ID (узнать у @userinfobot). Через запятую, если несколько. Пусто = бот отвечает всем.
ALLOWED_USERS=
# Часовой пояс по умолчанию
TZ=Europe/Moscow
# Путь к базе
DB_PATH=liss.db

# --- Нейросеть (необязательно) ---
# Ключ с console.anthropic.com. Без него бот работает, просто нет кнопки «🤖 Объясни подробнее».
ANTHROPIC_API_KEY=
# Модель. По умолчанию claude-opus-5-5 (самая умная). claude-haiku-5-5 — в десятки раз дешевле.
CLAUDE_MODEL=claude-opus-5-5

# --- Хостинг PythonAnywhere (бесплатный) ---
# На бесплатном аккаунте исходящие запросы идут только через прокси:
# TELEGRAM_PROXY=http://proxy.server:3128
